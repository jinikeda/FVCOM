 &NML_CASE
 CASE_TITLE      = 'lock exchange'                                                                 ,
 TIMEZONE        = 'none'                                                                          ,
 DATE_FORMAT     = 'YMD'                                                                           ,
 START_DATE      = 'cycles=0'                                                                      ,
 END_DATE        = 'cycles=300000'  
 /
 &NML_STARTUP
 STARTUP_TYPE    = 'coldstart'                                                                     ,
 STARTUP_FILE    = 'tst_its.nc'                                                                    ,
 STARTUP_UV_TYPE = 'default'                                                                       ,
 STARTUP_TURB_TYPE       = 'default'                                                               ,
 STARTUP_TS_TYPE = 'observed'                                                                      ,
 STARTUP_T_VALS  =  18                                                                             ,
 STARTUP_S_VALS  =  35.0                                                                           ,
 STARTUP_DMAX    =  -0.1     
 /
 &NML_IO
 INPUT_DIR       = './INPDIR'                                                                    ,
 OUTPUT_DIR      = './OUTDIR'                                                                    ,
 IREPORT =          1                                                                            ,
 VISIT_ALL_VARS  =  F,
 WAIT_FOR_VISIT  =  F,
 USE_MPI_IO_MODE =  F
 /

 &NML_INTEGRATION_X
 EXTSTEP_SECONDS =  0.0001 ,
 ISPLIT  =          10     ,
 IRAMP   =           0     ,
 MIN_DEPTH       =  0.01   ,
 STATIC_SSH_ADJ  =  0.0
 /

 &NML_INTEGRATION
 INTSTEP_SECONDS =  0.0002,
 IRAMP   =          0     ,
 MIN_DEPTH       =  0.01  ,
 STATIC_SSH_ADJ  =  0.0
 /

 &NML_RESTART
 RST_ON  = F,
 RST_FIRST_OUT   =  'cycles = 0'                                                                   ,
 RST_OUT_INTERVAL    = 'cycles=300000'                                                             ,
 RST_OUTPUT_STACK    =           0
 /
 &NML_NETCDF
 NC_ON   = T,
 NC_FIRST_OUT    = 'cycles=0'                                                                      ,
 NC_OUT_INTERVAL = 'cycles=1500'                                                                   ,
 NC_OUTPUT_STACK =           0,
 NC_GRID_METRICS = F,
 NC_FILE_DATE    = F,
 NC_VELOCITY     = T,
 NC_SALT_TEMP    = T,
 NC_TURBULENCE   = F,
 NC_AVERAGE_VEL  = F,
 NC_VERTICAL_VEL = T,
 NC_NH_QP        = F,
 NC_NH_RHS       = F,
 NC_WIND_VEL     = F,
 NC_WIND_STRESS  = F,
 NC_EVAP_PRECIP  = F,
 NC_SURFACE_HEAT = F,
 NC_GROUNDWATER  = F,
 NC_BIO  = F,
 NC_WQM  = F,
 NC_VORTICITY    = F
 /
 &NML_NETCDF_AV
 NCAV_ON = F                            ,
 NCAV_FIRST_OUT       = 'none'          ,
 NCAV_OUT_INTERVAL    = 'cycles=0 '     ,
 NCAV_OUTPUT_STACK    =  0              ,
 NCAV_SUBDOMAIN_FILES =  FVCOM          ,
 NCAV_GRID_METRICS    =  F              ,
 NCAV_FILE_DATE       =  F              ,
 NCAV_VELOCITY        =  F              ,
 NCAV_SALT_TEMP       =  F              ,
 NCAV_TURBULENCE      =  F              ,
 NCAV_AVERAGE_VEL     =  F              ,
 NCAV_VERTICAL_VEL    =  F              ,
 NCAV_NH_QP           =  F              ,
 NCAV_NH_RHS          =  F              ,
 NCAV_WIND_VEL        =  F              ,
 NCAV_WIND_STRESS     =  F              ,
 NCAV_EVAP_PRECIP     =  F              ,
 NCAV_SURFACE_HEAT    =  F              ,
 NCAV_GROUNDWATER     =  F              ,
 NCAV_BIO             =  F              ,
 NCAV_WQM             =  F              ,
 NCAV_VORTICITY       =  F
 /
 &NML_NETCDF_SURFACE
 NCSF_ON = F,
 NCSF_FIRST_OUT  = 'Date to start NETCDF OUTPUT: Format the same as START_DATE'                    ,
 NCSF_OUT_INTERVAL       = "A length of time: 'seconds= ','days= ', or 'cycles= '"                 ,
 NCSF_OUTPUT_STACK       = 0         ,
 NCSF_SUBDOMAIN_FILES    = FVCOM     ,
 NCSF_GRID_METRICS       = F         ,
 NCSF_FILE_DATE          = F         ,
 NCSF_VELOCITY           = F         ,
 NCSF_SALT_TEMP          = F         ,
 NCSF_TURBULENCE         = F         ,
 NCSF_WIND_VEL           = F         ,
 NCSF_WIND_STRESS        = F         ,
 NCSF_EVAP_PRECIP        = F         ,
 NCSF_SURFACE_HEAT       = F
 /
 &NML_SURFACE_FORCING
