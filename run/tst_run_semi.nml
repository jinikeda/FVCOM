 NCNEST_BLOCKSIZE        =   -1       ,
 NCNEST_NODE_FILES       = none       ,
 NCNEST_OUT_INTERVAL     = "A length of time: 'seconds= ','days= ', or 'cycles= '"
 /
 &NML_NH
 PROJ_SWITCH     =   999999
 /
 &NML_SEMI
