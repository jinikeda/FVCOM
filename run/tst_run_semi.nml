 BEDF    =   0.0     ,
 KSTAGE_UV       =           1,
 KSTAGE_TE       =           1,
 KSTAGE_TS       =           1,
 MSTG    = slow
 /
 &NML_BOUNDSCHK
 BOUNDSCHK_ON    = F,
