 DEPTH_FILE      = tst_dep.dat                                                                     ,
 CORIOLIS_FILE   = tst_cor.dat                                                                     ,
 SPONGE_FILE     = tst_spg.dat                                                                     
 /
 &NML_GROUNDWATER
 GROUNDWATER_ON  = F,
 GROUNDWATER_TEMP_ON     = F,
 GROUNDWATER_SALT_ON     = F,
 /
 &NML_LAG
