 OBC_SALT_NUDGING_TIMESCALE      =  0.000000000000000E+000,
 OBC_MEANFLOW    = F,
 OBC_MEANFLOW_FILE       = tst_obc.nc                                                              ,
 OBC_LONGSHORE_FLOW_ON   = F,
 OBC_LONGSHORE_FLOW_FILE = tst_lsf.dat                                                                     
 /
 &NML_GRID_COORDINATES
